{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crypto Lab",
  "version": "0.1.0",
  "identifier": "io.github.waydefu.cryptolab",
  "build": {
    "beforeBuildCommand": "npm run stage:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Crypto Lab｜交易研究工作台",
        "width": 1180,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
